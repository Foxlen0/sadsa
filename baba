task.spawn(function()
    local cacheFileName = "foxlen_bloxfruit.lua"
    local scriptCode = nil

    -- 1. Yerel diskte önbellek var mı kontrol et (Ağ beklemesini sıfırlar)
    if isfile and isfile(cacheFileName) and readfile then
        pcall(function()
            local c = readfile(cacheFileName)
            if c and #c > 100000 then scriptCode = c end
        end)
    end

    -- 2. Yoksa CDN'den indir ve diske kaydet
    if not scriptCode then
        pcall(function()
            local res = game:HttpGet("https://cdn.keysystem.pro/h4xscripts/bloxfruit", true)
            if res and #res > 100000 then
                scriptCode = res
                if writefile then pcall(writefile, cacheFileName, res) end
            end
        end)
    end

    -- Yedek kaynak
    if not scriptCode then
        pcall(function()
            scriptCode = game:HttpGet("https://raw.githubusercontent.com/realredz/BloxFruits/refs/heads/main/Source.lua", true)
        end)
    end

    -- 3. Ana iş parçacığını dondurmadan arka planda çalıştır
    if scriptCode then
        task.defer(function()
            local fn = loadstring(scriptCode)
            if fn then pcall(fn) end
        end)
    end
end)

