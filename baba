-- // 3. PRO PLAYER ESP & YAN PANEL CAN BARI (Event-Driven: 0 CPU Yükü)
local function ClearPlayerVisuals(char)
    if not char then return end
    local hl = char:FindFirstChild("Foxlen_Chams")
    if hl then hl:Destroy() end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local bb = root:FindFirstChild("Foxlen_SideESP")
        if bb then bb:Destroy() end
    end
end

local function ApplyPlayerESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    ClearPlayerVisuals(char)
    if not Config.PlayerESP then return end

    local isMarine = (tostring(player.Team) == "Marines")

    -- A) GLOW CHAMS (Duvardan Silüet)
    if Config.Chams then
        local hl = Instance.new("Highlight")
        hl.Name = "Foxlen_Chams"
        hl.FillColor = isMarine and Color3.fromRGB(0, 160, 255) or Color3.fromRGB(255, 45, 65)
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = char
        hl.Parent = char
        table.insert(Cache.Highlights, hl)
    end

    -- B) YAN PANEL CAN BARI & İSİM BİLLBOARD
    if Config.SideHealth or Config.NameDist then
        local bb = Instance.new("BillboardGui")
        bb.Name = "Foxlen_SideESP"
        bb.Adornee = root
        bb.Size = UDim2.fromOffset(130, 42)
        bb.StudsOffset = Vector3.new(0, 3.2, 0)
        bb.AlwaysOnTop = true
        bb.ResetOnSpawn = false
        bb.Parent = root

        local container = Instance.new("Frame")
        container.Size = UDim2.fromScale(1, 1)
        container.BackgroundTransparency = 1
        container.Parent = bb

        -- Dikey Can Barı (Yan Panel)
        local barFill = nil
        if Config.SideHealth then
            local barBg = Instance.new("Frame")
            barBg.Name = "HealthBg"
            barBg.Position = UDim2.new(0, 0, 0, 2)
            barBg.Size = UDim2.new(0, 4, 1, -4)
            barBg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
            barBg.BorderSizePixel = 0
            barBg.Parent = container

            local stroke = Instance.new("UIStroke")
            stroke.Color = Color3.fromRGB(0, 0, 0)
            stroke.Thickness = 1
            stroke.Parent = barBg

            barFill = Instance.new("Frame")
            barFill.Name = "HealthFill"
            barFill.AnchorPoint = Vector2.new(0, 1)
            barFill.Position = UDim2.new(0, 0, 1, 0)
            local p = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            barFill.Size = UDim2.new(1, 0, p, 0)
            barFill.BackgroundColor3 = Color3.fromHSV(p * 0.33, 0.9, 0.9)
            barFill.BorderSizePixel = 0
            barFill.Parent = barBg
        end

        -- İsim & Mesafe
        local nameLbl, subLbl
        if Config.NameDist then
            nameLbl = Instance.new("TextLabel")
            nameLbl.Position = UDim2.new(0, 10, 0, 0)
            nameLbl.Size = UDim2.new(1, -10, 0, 14)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Text = player.DisplayName
            nameLbl.TextColor3 = isMarine and Color3.fromRGB(120, 200, 255) or Color3.fromRGB(255, 120, 130)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 11
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextStrokeTransparency = 0.3
            nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
            nameLbl.Parent = container

            subLbl = Instance.new("TextLabel")
            subLbl.Position = UDim2.new(0, 10, 0, 14)
            subLbl.Size = UDim2.new(1, -10, 0, 12)
            subLbl.BackgroundTransparency = 1
            local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
            subLbl.Text = string.format("HP: %d%% | %dm", math.floor((hum.Health / hum.MaxHealth) * 100), dist)
            subLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
            subLbl.Font = Enum.Font.GothamMedium
            subLbl.TextSize = 9
            subLbl.TextXAlignment = Enum.TextXAlignment.Left
            subLbl.TextStrokeTransparency = 0.5
            subLbl.Parent = container
        end

        -- Sadece can değiştiğinde çalışır (Sıfır lag)
        hum.HealthChanged:Connect(function(newHealth)
            local perc = math.clamp(newHealth / math.max(hum.MaxHealth, 1), 0, 1)
            if barFill then
                barFill.Size = UDim2.new(1, 0, perc, 0)
                barFill.BackgroundColor3 = Color3.fromHSV(perc * 0.33, 0.9, 0.9)
            end
            if subLbl and root then
                local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
                subLbl.Text = string.format("HP: %d%% | %dm", math.floor(perc * 100), dist)
            end
        end)

        table.insert(Cache.Billboards, bb)
    end
end

local function RefreshPlayerESP()
    for _, hl in ipairs(Cache.Highlights) do pcall(function() hl:Destroy() end) end
    for _, bb in ipairs(Cache.Billboards) do pcall(function() bb:Destroy() end) end
    Cache.Highlights = {}
    Cache.Billboards = {}

    if Config.PlayerESP then
        for _, p in ipairs(Players:GetPlayers()) do
            pcall(function() ApplyPlayerESP(p) end)
        end
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Config.PlayerESP then ApplyPlayerESP(p) end
    end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        if Config.PlayerESP then ApplyPlayerESP(p) end
    end)
end

-- // 4. FRUIT, CHEST & MIRAGE ISLAND ESP (Hafif ve Olay Güdümlü)
local function CreateWorldTag(adornee, title, color)
    local bb = Instance.new("BillboardGui")
    bb.Name = "Foxlen_WorldTag"
    bb.Adornee = adornee
    bb.Size = UDim2.fromOffset(140, 24)
    bb.AlwaysOnTop = true
    bb.Parent = adornee

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.Text = title
    lbl.TextColor3 = color
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 11
    lbl.TextStrokeTransparency = 0.3
    lbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    lbl.Parent = bb
    table.insert(Cache.WorldTags, bb)
end

local function ClearWorldTags()
    for _, tag in ipairs(Cache.WorldTags) do pcall(function() tag:Destroy() end) end
    Cache.WorldTags = {}
end

local function ScanWorldEntities()
    ClearWorldTags()
    
    -- Meyveler (Fruit ESP)
    if Config.FruitESP then
        for _, item in ipairs(workspace:GetChildren()) do
            if item:IsA("Tool") or (item:IsA("Model") and item.Name:find("Fruit")) then
                local part = item:FindFirstChildWhichIsA("BasePart")
                if part then
                    CreateWorldTag(part, "🍇 " .. item.Name, Color3.fromRGB(190, 75, 255))
                end
            end
        end
    end

    -- Sandıklar (Chest ESP)
    if Config.ChestESP then
        for _, item in ipairs(workspace:GetChildren()) do
            if item.Name:find("Chest") then
                local part = item:IsA("BasePart") and item or item:FindFirstChildWhichIsA("BasePart")
                if part then
                    CreateWorldTag(part, "🪙 " .. item.Name, Color3.fromRGB(255, 215, 0))
                end
            end
        end
    end

    -- Mirage Island & Blue Gear ESP
    if Config.MirageESP then
        local mirage = workspace:FindFirstChild("Mirage Island") or workspace:FindFirstChild("Locations") and workspace.Locations:FindFirstChild("Mirage Island")
        if mirage then
            local center = mirage:FindFirstChildWhichIsA("BasePart")
            if center then
                CreateWorldTag(center, "🌟 MIRAGE ISLAND (Active)", Color3.fromRGB(0, 255, 200))
            end
            -- Mavi Çark (Blue Gear) Taraması
            for _, obj in ipairs(mirage:GetChildren()) do
                if obj.Name:find("Gear") or obj.Name:find("Blue") then
                    CreateWorldTag(obj, "⚙️ BLUE GEAR (Race V4)", Color3.fromRGB(80, 180, 255))
                end
            end
        end
    end
end

-- // 5. JESUS MODE & INFINITE GEPPO UTILITIES
local function SetupUtilities()
    -- Su Üstünde Yürüme (Jesus Mode)
    RunService.Stepped:Connect(function()
        if Config.JesusMode and LocalPlayer.Character then
            local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if root and root.Position.Y <= 0.5 and root.Position.Y >= -10 then
                root.Velocity = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
                root.CFrame = CFrame.new(root.Position.X, 1.2, root.Position.Z)
            end
        end
    end)

    -- Sonsuz Geppo (Skyjump)
    UserInputService.JumpRequest:Connect(function()
        if Config.InfiniteGeppo and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end
task.spawn(SetupUtilities)

-- // 6. ULTRA FPS BOOST (240 FPS Kilit)
local function SetFPSBoost(state)
    Config.FPSBoost = state
    pcall(function()
        if Config.FPSBoost then
            Lighting.GlobalShadows = false
            for _, fx in ipairs(Lighting:GetChildren()) do
                if fx:IsA("BlurEffect") or fx:IsA("SunRaysEffect") or fx:IsA("BloomEffect") then
                    fx.Enabled = false
                end
            end
            local t = workspace:FindFirstChildOfClass("Terrain")
            if t then t.WaterWaveSize = 0; t.WaterWaveSpeed = 0 end
        else
            Lighting.GlobalShadows = true
            for _, fx in ipairs(Lighting:GetChildren()) do
                if fx:IsA("BlurEffect") or fx:IsA("SunRaysEffect") or fx:IsA("BloomEffect") then
                    fx.Enabled = true
                end
            end
        end
    end)
end

