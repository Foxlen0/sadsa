-- // 2. SERVİSLER
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Global Durum
local ProVisuals = {
    PlayerESP = false,
    Chams = false,
    Highlights = {},
    Billboards = {}
}

-- // 3. PRO YAN PANEL CAN BARI & GLOW CHAMS SİSTEMİ (0 CPU Yükü)
local function ClearPlayerVisuals(char)
    if not char then return end
    local hl = char:FindFirstChild("Foxlen_Chams")
    if hl then hl:Destroy() end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        local bb = root:FindFirstChild("Foxlen_SideESP")
        if bb then bb:Destroy() end
    end
end

local function ApplyPlayerESP(player)
    if player == LocalPlayer then return end
    local char = player.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    ClearPlayerVisuals(char)

    local isMarine = (tostring(player.Team) == "Marines")

    -- A) GLOW CHAMS (Duvardan Silüet)
    if ProVisuals.Chams then
        local hl = Instance.new("Highlight")
        hl.Name = "Foxlen_Chams"
        hl.FillColor = isMarine and Color3.fromRGB(0, 160, 255) or Color3.fromRGB(255, 45, 65)
        hl.FillTransparency = 0.5
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0.1
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee = char
        hl.Parent = char
        table.insert(ProVisuals.Highlights, hl)
    end

    -- B) YAN PANEL CAN BARI & İSİM ESP
    if ProVisuals.PlayerESP then
        local bb = Instance.new("BillboardGui")
        bb.Name = "Foxlen_SideESP"
        bb.Adornee = root
        bb.Size = UDim2.fromOffset(130, 42)
        bb.StudsOffset = Vector3.new(0, 3.2, 0)
        bb.AlwaysOnTop = true
        bb.ResetOnSpawn = false
        bb.Parent = root

        local container = Instance.new("Frame")
        container.Size = UDim2.fromScale(1, 1)
        container.BackgroundTransparency = 1
        container.Parent = bb

        -- Dikey Can Barı (Yan Panel)
        local barBg = Instance.new("Frame")
        barBg.Name = "HealthBg"
        barBg.Position = UDim2.new(0, 0, 0, 2)
        barBg.Size = UDim2.new(0, 4, 1, -4)
        barBg.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
        barBg.BorderSizePixel = 0
        barBg.Parent = container

        local stroke = Instance.new("UIStroke")
        stroke.Color = Color3.fromRGB(0, 0, 0)
        stroke.Thickness = 1
        stroke.Parent = barBg

        local barFill = Instance.new("Frame")
        barFill.Name = "HealthFill"
        barFill.AnchorPoint = Vector2.new(0, 1)
        barFill.Position = UDim2.new(0, 0, 1, 0)
        local initialPerc = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
        barFill.Size = UDim2.new(1, 0, initialPerc, 0)
        barFill.BackgroundColor3 = Color3.fromHSV(initialPerc * 0.33, 0.9, 0.9)
        barFill.BorderSizePixel = 0
        barFill.Parent = barBg

        -- Küçük Şık İsim
        local nameLbl = Instance.new("TextLabel")
        nameLbl.Position = UDim2.new(0, 10, 0, 0)
        nameLbl.Size = UDim2.new(1, -10, 0, 14)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = player.DisplayName
        nameLbl.TextColor3 = isMarine and Color3.fromRGB(120, 200, 255) or Color3.fromRGB(255, 120, 130)
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextSize = 11
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextStrokeTransparency = 0.3
        nameLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        nameLbl.Parent = container

        -- Mesafe & Can
        local subLbl = Instance.new("TextLabel")
        subLbl.Position = UDim2.new(0, 10, 0, 14)
        subLbl.Size = UDim2.new(1, -10, 0, 12)
        subLbl.BackgroundTransparency = 1
        local dist = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
        subLbl.Text = string.format("HP: %d%% | %dm", math.floor(initialPerc * 100), dist)
        subLbl.TextColor3 = Color3.fromRGB(220, 220, 220)
        subLbl.Font = Enum.Font.GothamMedium
        subLbl.TextSize = 9
        subLbl.TextXAlignment = Enum.TextXAlignment.Left
        subLbl.TextStrokeTransparency = 0.5
        subLbl.Parent = container

        -- Olay Güdümlü: Sadece can azaldığında çalışır (Sıfır CPU yükü)
        hum.HealthChanged:Connect(function(newHealth)
            local p = math.clamp(newHealth / math.max(hum.MaxHealth, 1), 0, 1)
            barFill.Size = UDim2.new(1, 0, p, 0)
            barFill.BackgroundColor3 = Color3.fromHSV(p * 0.33, 0.9, 0.9)
            if root then
                local d = math.floor((Camera.CFrame.Position - root.Position).Magnitude)
                subLbl.Text = string.format("HP: %d%% | %dm", math.floor(p * 100), d)
            end
        end)

        table.insert(ProVisuals.Billboards, bb)
    end
end

local function RefreshVisuals()
    for _, hl in ipairs(ProVisuals.Highlights) do pcall(function() hl:Destroy() end) end
    for _, bb in ipairs(ProVisuals.Billboards) do pcall(function() bb:Destroy() end) end
    ProVisuals.Highlights = {}
    ProVisuals.Billboards = {}

    for _, p in ipairs(Players:GetPlayers()) do
        pcall(function() ApplyPlayerESP(p) end)
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        ApplyPlayerESP(p)
    end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        ApplyPlayerESP(p)
    end)
end

-- // 4. DANDİK DAHİLİ YAZILARI BASTIRICI
workspace.ChildAdded:Connect(function(child)
    if child:IsA("BillboardGui") and not child.Name:find("Foxlen_") then
        task.wait()
        for _, desc in ipairs(child:GetDescendants()) do
            if desc:IsA("TextLabel") and desc.Text:find("studs") then
                child.Enabled = false
            end
        end
    end
end)

-- // 5. HİLENİN KENDİ 'VISUALS' SEKME BUTONLARINA ENTEGRASYON (Native Hooking)
task.spawn(function()
    task.wait(3)

    local function HookCheatUI()
        local roots = {}
        if gethui then table.insert(roots, gethui()) end
        if game:GetService("CoreGui") then table.insert(roots, game:GetService("CoreGui")) end
        if LocalPlayer:FindFirstChild("PlayerGui") then table.insert(roots, LocalPlayer.PlayerGui) end

        for _, root in ipairs(roots) do
            for _, desc in ipairs(root:GetDescendants()) do
                -- Menüdeki 'Player ESP' Toggle'ı
                if desc:IsA("TextLabel") and desc.Text == "Player ESP" then
                    local container = desc.Parent
                    if container then
                        local btn = container:FindFirstChildWhichIsA("TextButton") or container:FindFirstChildWhichIsA("ImageButton")
                        if btn and not btn:GetAttribute("FoxlenHooked") then
                            btn:SetAttribute("FoxlenHooked", true)
                            btn.MouseButton1Click:Connect(function()
                                task.wait(0.1)
                                ProVisuals.PlayerESP = not ProVisuals.PlayerESP
                                RefreshVisuals()
                            end)
                        end
                    end
                -- Menüdeki 'Highlight Players' Toggle'ı
                elseif desc:IsA("TextLabel") and desc.Text == "Highlight Players" then
                    local container = desc.Parent
                    if container then
                        local btn = container:FindFirstChildWhichIsA("TextButton") or container:FindFirstChildWhichIsA("ImageButton")
                        if btn and not btn:GetAttribute("FoxlenHooked") then
                            btn:SetAttribute("FoxlenHooked", true)
                            btn.MouseButton1Click:Connect(function()
                                task.wait(0.1)
                                ProVisuals.Chams = not ProVisuals.Chams
                                RefreshVisuals()
                            end)
                        end
                    end
                -- Başlık ve Freemium Rozetini Değiştir
                elseif desc:IsA("TextLabel") and desc.Text:find("H4xscripts") then
                    desc.Text = desc.Text:gsub("H4xscripts", "foxlen0")
                elseif desc:IsA("TextLabel") and desc.Text:find("BloxFruit by Pratik") then
                    desc.Text = "BloxFruit by foxlen0"
                elseif desc:IsA("TextLabel") and (desc.Text == "Freemium" or desc.Text:find("Freemium")) then
                    desc.Text = "VIP Premium"
                end
            end
        end
    end

    HookCheatUI()
end)

